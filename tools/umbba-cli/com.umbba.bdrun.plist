<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  맥 24시간 무인 수집+분류 (옵션 C, 유료 Vision API 0).
  설치:
    1) __UMBBA_CLI_DIR__ 를 실제 경로로 치환 (예: /Users/이름/umbba-radar/tools/umbba-cli)
    2) Hour/Minute 를 "다른 작업과 안 겹치는 시각"으로 (분류가 길 수 있어 새벽 권장)
    3) chmod +x __UMBBA_CLI_DIR__/bd-run.sh
    4) cp com.umbba.bdrun.plist ~/Library/LaunchAgents/
    5) launchctl load ~/Library/LaunchAgents/com.umbba.bdrun.plist
  해제: launchctl unload ~/Library/LaunchAgents/com.umbba.bdrun.plist
  즉시 1회 테스트: launchctl start com.umbba.bdrun   (또는 직접 ./bd-run.sh)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.umbba.bdrun</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__UMBBA_CLI_DIR__/bd-run.sh</string>
    <string>1</string>     <!-- scan_days (매일이면 1) -->
  </array>

  <!-- 매일 이 시각. 다른 작업과 안 겹치게 조정. 분류가 길어 새벽 권장. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__UMBBA_CLI_DIR__/bd-run-launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__UMBBA_CLI_DIR__/bd-run-launchd.err</string>
</dict>
</plist>
