# umbba-cli 환경 변수 — .env로 복사 후 실제 값 입력
# .env는 .gitignore로 제외돼 있음

# 우리 Vercel 도메인 (변경 거의 X)
UMBBA_API_URL=https://umbba-radar.com

# Vercel env에 등록한 토큰과 동일한 값
# 생성: openssl rand -hex 32  또는  1Password 비밀번호 생성기
# Vercel Dashboard > Settings > Environment Variables 에서 ADMIN_CLI_TOKEN 추가
ADMIN_CLI_TOKEN=여기에_실제_토큰_입력

# 인스타 rate limit 회피 — 각 URL 사이 sleep (초). 차단되면 5.0 등으로 늘림
UMBBA_SLEEP=2.0

# 인스타 로그인 쿠키 (둘 중 하나 — 비로그인 시 차단됨)
# 권장: 파일 방식. Firefox 확장 "cookies.txt"로 인스타에서 export 후 이 폴더에 cookies.txt 저장.
UMBBA_COOKIES_FILE=cookies.txt
# 또는 브라우저 자동 추출 (Chrome은 DPAPI 이슈로 비추천. Firefox는 일부 환경 호환 X)
# UMBBA_COOKIES_BROWSER=firefox

# --- Bright Data 스캔 PoC (bd_scan.py) ---
# Settings > API tokens 에서 발급한 토큰. ⚠️ 채팅·캡처에 노출됐던 토큰은 폐기 후 재발급할 것.
BRIGHTDATA_API_TOKEN=여기에_재발급한_토큰_입력
# Instagram - Posts 데이터셋 id (discover by url). 비우면 코드 기본값 사용.
BRIGHTDATA_DATASET_ID=gd_lk5ns7kz21pck8jpis

# --- 옵션 C 분류(bd_classify.py): 로컬 헤드리스 Claude 인증 ---
# `claude setup-token` 으로 발급한 OAuth 토큰(1년). bd-run.sh 가 이걸 export 해서 claude 서브프로세스에 전달.
# ⚠️ 계정 토큰이라 노출되면 재발급 권장.
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-여기에_setup-token_발급값

# --- 예비 수집기 HikerAPI (hiker_client.py) — BD 계정 스캔 이상 시 bd_ingest 가 자동 전환 ---
# hikerapi.com 가입 → 대시보드의 Access Key. 비우면 전환 안 하고 🔴 "예비 수집기 미설정" 경보만.
HIKERAPI_KEY=
# 1회 실행 요청 상한(≈ 1.4원/요청). 예비 대상은 bd_ingest --fallback-max(기본 300계정, 최근 카드 계정 우선).
HIKER_MAX_REQUESTS=700

# --- 예비 수집기 2: Apify instagram-post-scraper (apify_client.py) — 게시물 1건당 과금, 무료 플랜 월 크레딧으로도 동작 ---
# console.apify.com > Settings > API & Integrations > Personal API token
APIFY_TOKEN=
# 1회 실행 비용 상한 USD (run 의 maxTotalChargeUsd)
APIFY_MAX_USD=1.5
# 예비 체인 순서 (BD 이상 시 앞에서부터, 미설정·잔액 0은 건너뛰고 못 본 계정만 다음으로)
FALLBACK_ORDER=hiker,apify
